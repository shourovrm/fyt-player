From fb4db572f4b5278a5a862e77cdd938a847458b95 Mon Sep 17 00:00:00 2001
From: Riad Mashrub Shourov <shourovrm@gmail.com>
Date: Fri, 6 Nov 2026 11:14:11 +0600
Subject: [PATCH 1/4] patch: search collects reelShelfRenderer shorts + JDK 21
 toolchain

---
 build.gradle                                       |  2 +-
 .../youtube/extractors/YoutubeSearchExtractor.java | 14 ++++++++++++++
 settings.gradle                                    |  3 +++
 3 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/build.gradle b/build.gradle
index 04ad27f0..e223318b 100644
--- a/build.gradle
+++ b/build.gradle
@@ -4,7 +4,7 @@ allprojects {
 
     java {
         toolchain {
-            languageVersion = JavaLanguageVersion.of(25)
+            languageVersion = JavaLanguageVersion.of(21)
         }
         withSourcesJar()
     }
diff --git a/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeSearchExtractor.java b/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeSearchExtractor.java
index a248c97f..4f00109f 100644
--- a/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeSearchExtractor.java
+++ b/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeSearchExtractor.java
@@ -199,6 +199,20 @@ public class YoutubeSearchExtractor extends YoutubeBaseSearchExtractor {
             } else if (item.has("shortsLockupViewModel")) {
                 collector.commit(new YoutubeShortsInfoItemExtractor(
                         item.getObject("shortsLockupViewModel")));
+            } else if (item.has("reelShelfRenderer")) {
+                // Shorts shelf section (older SERP shape): without this branch every short
+                // YouTube groups into a reel shelf is silently dropped. Upstream 5.5.0 already
+                // walks gridShelfViewModel and bare shortsLockupViewModel below.
+                for (final Object reel : item.getObject("reelShelfRenderer").getArray("items")) {
+                    final JsonObject reelItem = (JsonObject) reel;
+                    if (reelItem.has("reelItemRenderer")) {
+                        collector.commit(new YoutubeStreamInfoItemExtractor(
+                                reelItem.getObject("reelItemRenderer"), timeAgoParser));
+                    } else if (reelItem.has("shortsLockupViewModel")) {
+                        collector.commit(new YoutubeShortsInfoItemExtractor(
+                                reelItem.getObject("shortsLockupViewModel")));
+                    }
+                }
             } else if (item.has("gridShelfViewModel")) {
                 final JsonArray shelfContents = item.getObject("gridShelfViewModel")
                         .getArray("contents");
diff --git a/settings.gradle b/settings.gradle
index 4867e4ba..7ae72e9a 100644
--- a/settings.gradle
+++ b/settings.gradle
@@ -1,2 +1,5 @@
+plugins {
+    id 'org.gradle.toolchains.foojay-resolver-convention' version '1.0.0'
+}
 include 'extractor', 'timeago-parser'
 rootProject.name = 'PipePipeExtractor'
-- 
