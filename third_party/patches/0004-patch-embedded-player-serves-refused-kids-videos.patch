+    /**
+     * Fetches the formats the embedded player (Innertube client WEB_EMBEDDED_PLAYER) serves, the
+     * way yt-dlp's {@code web_embedded} client does. YouTube only answers when the player request
+     * echoes the {@code encryptedHostFlags} and visitor data of an embed page fetched with the
+     * embedding page as Referer, and names that same page as {@code thirdParty.embedUrl}. The page
+     * can be any non-YouTube URL.
+     */
+    private void extractWebEmbeddedFormats(@Nonnull final String videoId)
+            throws IOException, ExtractionException {
+        final Localization localization = getExtractorLocalization();
+        final ContentCountry contentCountry = getExtractorContentCountry();
+
+        // The consent cookie keeps both requests logged out (a signed-in embed page carries no host
+        // flags) and stops an app downloader from adding the account's session cookie instead.
+        final Map<String, List<String>> pageHeaders = new HashMap<>();
+        pageHeaders.put("User-Agent", singletonList(WEB_EMBEDDED_USER_AGENT));
+        pageHeaders.put("Referer", singletonList(WEB_EMBEDDED_EMBED_URL));
+        pageHeaders.put("Cookie", singletonList(generateConsentCookie()));
+        final String embedPage = getDownloader()
+                .get("https://www.youtube.com/embed/" + videoId + "?html5=1", pageHeaders,
+                        localization)
+                .responseBody();
+        final String hostFlags = matchEmbedConfig(WEB_EMBEDDED_HOST_FLAGS_PATTERN, embedPage);
+        final String visitorData = matchEmbedConfig(WEB_EMBEDDED_VISITOR_DATA_PATTERN, embedPage);
+        final String clientVersion = matchEmbedConfig(WEB_EMBEDDED_CLIENT_VERSION_PATTERN,
+                embedPage);
+
+        final String cpn = generateContentPlaybackNonce();
+        final byte[] body = JsonWriter.string(JsonObject.builder()
+                .object("context")
+                    .object("client")
+                        .value("hl", localization.getLocalizationCode())
+                        .value("gl", contentCountry.getCountryCode())
+                        .value("clientName", WEB_EMBEDDED_CLIENT_NAME)
+                        .value("clientVersion", clientVersion)
+                        .value("userAgent", WEB_EMBEDDED_USER_AGENT)
+                        .value("visitorData", visitorData)
+                    .end()
+                    .object("thirdParty")
+                        .value("embedUrl", WEB_EMBEDDED_EMBED_URL)
+                    .end()
+                .end()
+                .object("playbackContext")
+                    .object("contentPlaybackContext")
+                        .value("html5Preference", "HTML5_PREF_WANTS")
+                        .value("signatureTimestamp",
+                                YoutubeJavaScriptPlayerManager.getSignatureTimestamp(videoId))
+                        .value("encryptedHostFlags", hostFlags)
+                    .end()
+                .end()
+                .value(CPN, cpn)
+                .value(VIDEO_ID, videoId)
+                .value(CONTENT_CHECK_OK, true)
+                .value(RACY_CHECK_OK, true)
+                .done()).getBytes(StandardCharsets.UTF_8);
+        final Map<String, List<String>> headers = new HashMap<>();
+        headers.put("Content-Type", singletonList("application/json"));
+        headers.put("Origin", singletonList("https://www.youtube.com"));
+        headers.put("X-YouTube-Client-Name", singletonList(WEB_EMBEDDED_CLIENT_ID));
+        headers.put("X-YouTube-Client-Version", singletonList(clientVersion));
+        headers.put("User-Agent", singletonList(WEB_EMBEDDED_USER_AGENT));
+        headers.put("Cookie", singletonList(generateConsentCookie()));
+        final JsonObject response = JsonUtils.toJsonObject(getValidJsonResponseBody(
+                getDownloader().post(YOUTUBEI_V1_URL + "player?" + DISABLE_PRETTY_PRINT_PARAMETER,
+                        headers, body, localization)));
+        checkPlayabilityStatus(response.getObject("playabilityStatus"), videoId);
+        final JsonObject streamingData = response.getObject(STREAMING_DATA);
+        if (isNullOrEmpty(streamingData)) {
+            throw new ExtractionException("Embedded player response has no streaming data");
+        }
+        extractDirectFormatsFromArray(videoId, streamingData.getArray("formats"), cpn,
+                EnumSet.of(ItagItem.ItagType.VIDEO));
+        extractDirectFormatsFromArray(videoId, streamingData.getArray("adaptiveFormats"), cpn,
+                EnumSet.of(ItagItem.ItagType.AUDIO, ItagItem.ItagType.VIDEO_ONLY));
+        if (playerCaptionsTracklistRenderer == null) {
+            playerCaptionsTracklistRenderer = response.getObject("captions")
+                    .getObject("playerCaptionsTracklistRenderer");
+        }
+    }
+
+    @Nonnull
+    private static String matchEmbedConfig(@Nonnull final Pattern pattern,
+                                           @Nonnull final String embedPage)
+            throws ParsingException {
+        final Matcher matcher = pattern.matcher(embedPage);
+        if (!matcher.find()) {
+            throw new ParsingException("Embed page lacks " + pattern.pattern());
+        }
+        return matcher.group(1);
+    }
+
