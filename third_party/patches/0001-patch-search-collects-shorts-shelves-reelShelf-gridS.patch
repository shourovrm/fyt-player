From a696941b349862062f879e120527fe339f927014 Mon Sep 17 00:00:00 2001
From: Riad Mashrub Shourov <92566855+shourovrm@users.noreply.github.com>
Date: Sun, 30 Aug 2026 14:45:03 +0600
Subject: [PATCH 1/2] patch: search collects shorts shelves
 (reelShelf/gridShelf)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Search results skip every YouTube Shorts shelf (reelShelfRenderer,
gridShelfViewModel, and bare shortsLockupViewModel items) — without
this, search returns almost no shorts. Commits shelf items to the
existing collector via YoutubeStreamInfoItemExtractor/
YoutubeShortsInfoItemExtractor.

Also includes the local composite-build adaptation for fyi-player's
includeBuild: build.gradle pinned to JDK 21 toolchain (fyi-player's
build environment) and settings.gradle picks up the foojay-resolver
convention plugin needed to resolve that toolchain.
---
 build.gradle                                  |  2 +-
 .../extractors/YoutubeSearchExtractor.java    | 27 +++++++++++++++++++
 settings.gradle                               |  3 +++
 3 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/build.gradle b/build.gradle
index 0594f42f..1c38b846 100644
--- a/build.gradle
+++ b/build.gradle
@@ -4,7 +4,7 @@ allprojects {
 
     java {
         toolchain {
-            languageVersion = JavaLanguageVersion.of(25)
+            languageVersion = JavaLanguageVersion.of(21)
         }
         withSourcesJar()
     }
diff --git a/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeSearchExtractor.java b/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeSearchExtractor.java
index 7938e186..39e0b631 100644
--- a/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeSearchExtractor.java
+++ b/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeSearchExtractor.java
@@ -202,6 +202,33 @@ public class YoutubeSearchExtractor extends YoutubeBaseSearchExtractor {
                     collector.commit(
                             new YoutubeMixOrPlaylistLockupInfoItemExtractor(lockupViewModel));
                 }
+            } else if (item.has("reelShelfRenderer")) {
+                // Shorts shelf section: without this branch every short YouTube groups into a
+                // shelf is silently dropped and search returns almost no shorts at all.
+                for (final Object reel : item.getObject("reelShelfRenderer").getArray("items")) {
+                    final JsonObject reelItem = (JsonObject) reel;
+                    if (reelItem.has("reelItemRenderer")) {
+                        collector.commit(new YoutubeStreamInfoItemExtractor(
+                                reelItem.getObject("reelItemRenderer"), timeAgoParser));
+                    } else if (reelItem.has("shortsLockupViewModel")) {
+                        collector.commit(new YoutubeShortsInfoItemExtractor(
+                                reelItem.getObject("shortsLockupViewModel")));
+                    }
+                }
+            } else if (item.has("gridShelfViewModel")) {
+                // Current desktop SERP wraps the shorts shelf this way (verified live 2026-08:
+                // gridShelfViewModel.contents[].shortsLockupViewModel).
+                for (final Object grid : item.getObject("gridShelfViewModel")
+                        .getArray("contents")) {
+                    final JsonObject gridItem = (JsonObject) grid;
+                    if (gridItem.has("shortsLockupViewModel")) {
+                        collector.commit(new YoutubeShortsInfoItemExtractor(
+                                gridItem.getObject("shortsLockupViewModel")));
+                    }
+                }
+            } else if (item.has("shortsLockupViewModel")) {
+                collector.commit(new YoutubeShortsInfoItemExtractor(
+                        item.getObject("shortsLockupViewModel")));
             }
         }
     }
diff --git a/settings.gradle b/settings.gradle
index 4867e4ba..7ae72e9a 100644
--- a/settings.gradle
+++ b/settings.gradle
@@ -1,2 +1,5 @@
+plugins {
+    id 'org.gradle.toolchains.foojay-resolver-convention' version '1.0.0'
+}
 include 'extractor', 'timeago-parser'
 rootProject.name = 'PipePipeExtractor'
-- 
