Subject: [PATCH 3/3] patch: uploader handle for the watch page owner

The watch-page owner renderer carries the handle as
navigationEndpoint.browseEndpoint.canonicalBaseUrl ("/@handle"). StreamInfo had no field for it,
so this adds StreamExtractor.getUploaderHandle() (default empty), the YouTube override, and
fills it into StreamInfo next to the other uploader fields. Any other path gives an empty handle.
---
diff --git a/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeStreamExtractor.java b/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeStreamExtractor.java
index d888e08..e2e24e5 100644
--- a/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeStreamExtractor.java
+++ b/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/extractors/YoutubeStreamExtractor.java
@@ -550,6 +550,27 @@ public class YoutubeStreamExtractor extends StreamExtractor {
         return extractUploaderName(playerResponse, playerMicroFormatRenderer, videoOwnerRenderer);
     }
 
+    /** The owner link's canonical path is "/@handle"; only that shape is a handle. */
+    @Nonnull
+    @Override
+    public String getUploaderHandle() throws ParsingException {
+        assertPageFetched();
+
+        final JsonObject videoOwnerRenderer = getVideoSecondaryInfoRenderer()
+                .getObject("owner")
+                .getObject("videoOwnerRenderer");
+        final JsonObject navigationEndpoint = videoOwnerRenderer.getObject("navigationEndpoint");
+        if (navigationEndpoint == null || navigationEndpoint.getObject("browseEndpoint") == null) {
+            return "";
+        }
+        final String canonicalBaseUrl = navigationEndpoint.getObject("browseEndpoint")
+                .getString("canonicalBaseUrl", "");
+        if (!canonicalBaseUrl.startsWith("/@")) {
+            return "";
+        }
+        return canonicalBaseUrl.substring(1);
+    }
+
     @Nonnull
     static String extractUploaderName(@Nonnull final JsonObject selectedPlayerResponse,
                                       @Nullable final JsonObject webMicroformat,
diff --git a/extractor/src/main/java/org/schabi/newpipe/extractor/stream/StreamExtractor.java b/extractor/src/main/java/org/schabi/newpipe/extractor/stream/StreamExtractor.java
index 343c5b1..2cfe081 100644
--- a/extractor/src/main/java/org/schabi/newpipe/extractor/stream/StreamExtractor.java
+++ b/extractor/src/main/java/org/schabi/newpipe/extractor/stream/StreamExtractor.java
@@ -199,6 +199,17 @@ public abstract class StreamExtractor extends Extractor {
     @Nonnull
     public abstract String getUploaderUrl() throws ParsingException;
 
+    /**
+     * The handle of the creator/uploader as the service shows it next to the name (e.g. "@name"),
+     * without a leading slash. Services without handles keep this default.
+     *
+     * @return the handle of the creator/uploader of the stream or an empty string
+     */
+    @Nonnull
+    public String getUploaderHandle() throws ParsingException {
+        return "";
+    }
+
     /**
      * The name of the creator/uploader of the stream.
      * If the name is not available you can simply return an empty string.
diff --git a/extractor/src/main/java/org/schabi/newpipe/extractor/stream/StreamInfo.java b/extractor/src/main/java/org/schabi/newpipe/extractor/stream/StreamInfo.java
index c088e21..8f96d26 100644
--- a/extractor/src/main/java/org/schabi/newpipe/extractor/stream/StreamInfo.java
+++ b/extractor/src/main/java/org/schabi/newpipe/extractor/stream/StreamInfo.java
@@ -328,6 +328,11 @@ public class StreamInfo extends Info {
         } catch (final Exception e) {
             streamInfo.addError(e);
         }
+        try {
+            streamInfo.setUploaderHandle(extractor.getUploaderHandle());
+        } catch (final Exception e) {
+            streamInfo.addError(e);
+        }
         try {
             streamInfo.setStaffs(extractor.getStaffs());
         } catch (final Exception e) {
@@ -536,6 +541,7 @@ public class StreamInfo extends Info {
 
     private String uploaderName = "";
     private String uploaderUrl = "";
+    private String uploaderHandle = "";
     private String uploaderAvatarUrl = "";
     @Nonnull
     private List<Image> uploaderAvatars = Collections.emptyList();
@@ -755,6 +761,14 @@ public class StreamInfo extends Info {
         this.uploaderSubscriberCount = uploaderSubscriberCount;
     }
 
+    public String getUploaderHandle() {
+        return uploaderHandle;
+    }
+
+    public void setUploaderHandle(final String uploaderHandle) {
+        this.uploaderHandle = uploaderHandle;
+    }
+
     public Collection<StaffInfoItem> getStaffs() {
         return staffs;
     }
